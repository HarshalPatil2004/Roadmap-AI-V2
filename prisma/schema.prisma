generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Module {
  id             String    @id
  phaseId        String
  title          String
  description    String?
  order          Int
  estimatedHours Int?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  Phase          Phase     @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  Project        Project[]
  Topic          Topic[]

  @@unique([phaseId, order])
  @@index([phaseId])
}

model Phase {
  id             String   @id
  roadmapId      String
  title          String
  description    String?
  order          Int
  estimatedWeeks Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  Module         Module[]
  Roadmap        Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, order])
  @@index([roadmapId])
}

model Progress {
  id          String         @id
  topicId     String         @unique
  status      ProgressStatus @default(NOT_STARTED)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime
  Topic       Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Project {
  id             String            @id
  moduleId       String
  title          String
  description    String?
  difficulty     ProjectDifficulty
  estimatedHours Int?
  order          Int
  createdAt      DateTime          @default(now())
  updatedAt      DateTime
  Module         Module            @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, order])
  @@index([moduleId])
}

model Resource {
  id          String       @id
  topicId     String
  title       String
  url         String
  type        ResourceType
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime
  Topic       Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

model Roadmap {
  id                String          @id
  userId            String
  title             String
  technology        String
  goal              LearningGoal
  experienceLevel   ExperienceLevel
  estimatedDuration String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  Phase             Phase[]
  User              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Topic {
  id               String     @id
  moduleId         String
  title            String
  description      String?
  order            Int
  estimatedMinutes Int?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime
  Progress         Progress?
  Resource         Resource[]
  Module           Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, order])
  @@index([moduleId])
}

model User {
  id         String    @id
  name       String?
  email      String    @unique
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  authUserId String    @unique
  Roadmap    Roadmap[]
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum LearningGoal {
  JOB
  INTERVIEW
  COLLEGE
  FREELANCING
  PERSONAL_PROJECT
  CAREER_CHANGE
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum ProjectDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ResourceType {
  DOCUMENTATION
  YOUTUBE
  COURSE
  ARTICLE
  GITHUB
  PRACTICE
  OTHER
}
